      "source": [
        "import spacy\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "sentence = \"Faculty explains concepts clearly.\"\n",
        "doc = nlp(sentence)\n",
        "print(\"Dependency Relationships:\")\n",
        "for token in doc:\n",
        "  print(token.text, \"->\", token.head.text, \"(\", token.dep_, \")\")\n"
      ]
