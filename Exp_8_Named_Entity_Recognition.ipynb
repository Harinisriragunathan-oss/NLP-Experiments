      "source": [
        "import spacy\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "sentence = \"Anna University placement training was excellent.\"\n",
        "doc = nlp(sentence)\n",
        "print(\"Named Entities:\")\n",
        "for ent in doc.ents:\n",
        "  print(ent.text, \"->\", ent.label_)"
      ],
